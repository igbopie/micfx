[Unit]
Description=micfx — voice processor (2 mics)
After=sound.target
Wants=sound.target

[Service]
Type=simple
ExecStart=/usr/local/bin/micfx -c /etc/micfx/micfx.conf
Restart=on-failure
RestartSec=2
# Soft realtime: priority and locked memory (tune after measuring)
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
