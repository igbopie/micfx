[Unit]
Description=micfx — voice processor (2 mics)
After=sound.target
Wants=sound.target

[Service]
Type=simple
User=igbopie
ExecStart=/usr/local/bin/micfx -C hw:CARD=CODEC -P hw:CARD=CODEC -M bluealsa:PROFILE=a2dp -c /etc/micfx/micfx.conf
Restart=always
RestartSec=2
# Soft realtime: priority and locked memory (tune after measuring)
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
